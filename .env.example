# Satu berkas contoh, tiga lingkungan. Nilai nyata di SOPS.
APP_ENV=dev
APP_PORT=4000
WEB_PORT=3100
API_URL=http://127.0.0.1:4000
API_URL_INTERNAL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

DATABASE_URL=postgresql://app:CHANGE_ME@127.0.0.1:5432/kepegawaian?schema=public
PGBOUNCER_URL=postgresql://app:CHANGE_ME@127.0.0.1:6432/kepegawaian?pgbouncer=true
REDIS_URL=redis://127.0.0.1:6379/0

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_ARSIP=arsip
S3_BUCKET_DOSSIER=dossier

MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_API_KEY=CHANGE_ME

OIDC_ISSUER=http://127.0.0.1:8081/realms/tamalate
OIDC_CLIENT_ID=api
OIDC_CLIENT_SECRET=CHANGE_ME

# Kunci berbeda per lingkungan. Ini yang dijaga SOPS.
JWT_SIGNING_KEY=CHANGE_ME_PER_ENV
CAPABILITY_SIGNING_KEY=CHANGE_ME_PER_ENV
COLUMN_ENCRYPTION_KEY=CHANGE_ME_PER_ENV
